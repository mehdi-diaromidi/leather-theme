{
  "name": "leather-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Bagllet WordPress theme conversion — baseline and build tooling.",
  "type": "module",
  "scripts": {
    "qa:baseline": "node qa/baseline/capture.mjs",
    "qa:states": "node qa/baseline/states.mjs",
    "qa:login": "node qa/baseline/login.mjs",
    "qa:checks": "node qa/checks/forbidden.mjs",
    "qa:tokens-sync": "node qa/checks/tokens-sync.mjs",
    "qa:diff": "node qa/diff/compare.mjs",
    "qa:capture:candidate": "node qa/diff/capture-candidate.mjs",
    "qa:diff:specs": "node qa/diff/compare-specs.mjs",
    "qa:phpcs": "vendor/bin/phpcs --standard=phpcs.xml",
    "deploy": "node tools/deploy.mjs",
    "deploy:dry": "node tools/deploy.mjs --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "dotenv": "^18.0.10",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0"
  }
}
