# کپی کن به .env.local و پر کن (.env.local ignore است؛ هرگز commit نشود)
SITE_URL=https://baglletleather.com
# Optional: force Playwright host map if local proxy/DNS breaks (do not commit real value in docs)
BAGLLET_RESOLVE_IP=
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_ROOT=/public_html
# ورود به پنل: نیازی به یوزر/پسورد نیست؛ مدیر در مرورگر داخلی Cursor لاگین کرده است.
# کلید پیش‌نمایش قالب جدید → فایل سروری mu-plugins/bagllet-preview-key.php (نه wp-config)
BAGLLET_PREVIEW_KEY=
